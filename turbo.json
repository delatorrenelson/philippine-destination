{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "MONGODB_URI", "BETTER_AUTH_SECRET", "VITE_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".react-router/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}