{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@db": [
        "./db/index.js"
      ],
      "@db/*": [
        "./db/*"
      ]
    }
  },
  "include": [
    "./**/*.ts"
  ]
}