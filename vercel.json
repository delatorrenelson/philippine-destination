{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "build/server/**/*"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!assets/|fonts/|.*\\..*).*)",
      "destination": "/api/index.ts"
    }
  ]
}